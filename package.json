{
  "name": "pathmemory",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @pathmemory/api",
    "dev:web": "npm run dev --workspace @pathmemory/web",
    "dev:mobile": "npm run start --workspace @pathmemory/mobile",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace @pathmemory/api && npm run build --workspace @pathmemory/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
