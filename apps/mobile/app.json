{
  "expo": {
    "name": "PathMemory",
    "slug": "pathmemory",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép PathMemory dùng camera để xác nhận landmark tại nơi làm việc.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006D77"
      }
    }
  }
}
